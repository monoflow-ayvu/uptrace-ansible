[Unit]
Description = connection pooler for PostgreSQL

After = network-online.target
Wants = network-online.target
# Default start-rate limiting (5 failures in 10s) leaves PgBouncer permanently
# down after a transient failure; keep retrying forever instead.
StartLimitIntervalSec = 0
#Requires=pgbouncer.socket

[Service]
Type = notify
User = postgres

ExecStart  = /usr/sbin/pgbouncer /etc/pgbouncer/pgbouncer.ini
ExecReload = /bin/kill -HUP $MAINPID
KillSignal = SIGINT
Restart    = always
RestartSec = 5s

LimitNOFILE = 1024

[Install]
WantedBy=multi-user.target
